POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=finance_ai
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme

SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Least-privilege database role passwords (SEC-100). Created by the migrator's bootstrap step.
POSTGRES_APP_PASSWORD=changeme_app
POSTGRES_MIGRATOR_PASSWORD=changeme_migrator
POSTGRES_REPORTING_PASSWORD=changeme_reporting

# RS256 access-token signing key (SEC-03), base64-encoded PKCS#8 PEM. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
JWT_SIGNING_KEY_PEM_BASE64=

# Origins the SPA is served from (SEC-62). Comma-separated, no wildcards.
WEB_ORIGINS=http://localhost:5173
