POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=finance_ai
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# The From address on outbound reminders (slice 8). Mailpit accepts anything.
MAIL_FROM=collections@finance-ai.local
# Global outbound kill switch (SEC-103). Anything but true/1 stops every tenant's sending.
OUTBOUND_SENDING_ENABLED=true

# Local AI service (slice 9). The backend calls it on the internal network with the shared token (AI-101).
# The service refuses to start without a token of at least 16 characters. Generate: openssl rand -hex 24
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=
# Backend-side timeout for one classification (the service's own hard timeout is AI_TIMEOUT_SECONDS, default 20 per AI-10).
AI_SERVICE_TIMEOUT_SECONDS=25
# services/ai: where Ollama listens and which model to use. Raise AI_TIMEOUT_SECONDS on a CPU-only box.
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:4b
AI_TIMEOUT_SECONDS=20

# Least-privilege database role passwords (SEC-100). Created by the migrator's bootstrap step.
POSTGRES_APP_PASSWORD=changeme_app
POSTGRES_MIGRATOR_PASSWORD=changeme_migrator
POSTGRES_REPORTING_PASSWORD=changeme_reporting

# RS256 access-token signing key (SEC-03), base64-encoded PKCS#8 PEM. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
JWT_SIGNING_KEY_PEM_BASE64=
# Rotation (slice 17, runbook §4): the key being retired. Verifies only tokens issued before this process started.
JWT_SIGNING_KEY_PEM_BASE64_PREVIOUS=

# Key-encryption key for TOTP secrets at rest (SEC-02, slice 13): 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Without it MFA enrolment answers mfa_unavailable; Owners and Admins are then locked out after their grace period.
MFA_KEK_BASE64=
# Rotation (slice 17, runbook §4): the key being retired; secrets are re-sealed on sign-in and by `rotate-mfa-kek`.
MFA_KEK_BASE64_PREVIOUS=

# Origins the SPA is served from (SEC-62). Comma-separated, no wildcards.
WEB_ORIGINS=http://localhost:5173

# The alert path (SEC-102, slice 15). Operator addresses (comma-separated) get an email through the same SMTP host
# as everything else — outside the outbound kill switch, because an alert is how you learn the switch is needed.
# The webhook receives one JSON POST per alert (optional bearer). Both optional; the alert row and log line always exist.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
