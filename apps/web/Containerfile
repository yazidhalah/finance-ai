# finance-ai web (slice 14): the SPA built by Vite, served by nginx, which also proxies /api to the API container
# so the refresh cookie stays same-origin (SEC-63). Non-root nginx on :8080; security headers per SEC-61.
FROM docker.io/library/node:22-alpine AS build
WORKDIR /src
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web .
RUN npm run build

FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=0555 apps/web/nginx-resolver.sh /docker-entrypoint.d/05-resolver.sh
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080
